@extends('ignite::layouts.app')

@section('ignite_html')data-theme="{{ $theme }}"@endsection

@section('ignite_aside')
  @include('ignite::partials.nav')
@endsection

@section('ignite_column')ig-with-sidebar@endsection

@section('ignite_bar')
  <header class="sticky top-0 z-20 flex items-center border-b border-border bg-page px-5 py-3">
    @include('ignite::partials.topbar')
  </header>
@endsection

@section('ignite_flash')
  @include('ignite::partials.flash')
@endsection

@section('title')
  {{ $title }}
@endsection

@section('content')
  <section class="ig-card mb-6 bg-lightprimary shadow-none">
    <h1 class="mb-1 text-2xl">Welcome back, {{ $user_name }}</h1>
    <p class="m-0">Here is what is happening in your panel.</p>
  </section>

  <div class="grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(11rem,1fr))]">
    @forelse (card in cards)
      <div class="ig-card ig-tone-{{ $card.tone }} flex flex-col items-center gap-2 text-center shadow-none">
        <i class="ti {{ $card.icon }} text-4xl"></i>
        <p class="m-0 font-semibold">{{ $card.label }}</p>
        <p class="m-0 text-2xl font-semibold">{{ $card.value }}</p>
      </div>
    @empty
      <p class="col-span-full">No stats yet. A resource shows its cards here by implementing <code>widgets</code>.</p>
    @endforelse
  </div>

  @foreach (table in tables)
    <section class="ig-card mt-8 p-0">
      <h2 class="px-6 pt-6 pb-4">{{ $table.title }}</h2>
      <div class="overflow-x-auto">
        <table class="ig-table">
          <thead>
            <tr>
              @foreach (head in table.headers)
                <th>{{ $head.label }}</th>
              @endforeach
            </tr>
          </thead>
          <tbody>
            @forelse (row in table.rows)
              <tr>
                @foreach (cell in row.cells)
                  <td>{{ $cell.text }}</td>
                @endforeach
              </tr>
            @empty
              <tr><td class="text-text">No records yet.</td></tr>
            @endforelse
          </tbody>
        </table>
      </div>
    </section>
  @endforeach
@endsection
