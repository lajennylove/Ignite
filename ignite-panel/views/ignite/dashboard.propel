@section('content')
  <h1>{{ $title }}</h1>

  <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(12rem,1fr))]">
    @forelse (card in cards)
      <div class="rounded-lg border border-hairline bg-white p-4">
        <p class="m-0 text-[#5b6070]">{{ $card.label }}</p>
        <p class="mt-1 mb-0 text-[2rem] font-bold text-heading">{{ $card.value }}</p>
      </div>
    @empty
      <p class="text-[#5b6070]">No stats yet. A resource shows its cards here by implementing <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-[13px] text-accent">widgets</code>.</p>
    @endforelse
  </div>

  @foreach (table in tables)
    <section class="mt-10">
      <h2 class="mb-3">{{ $table.title }}</h2>
      <div class="overflow-x-auto rounded-lg border border-hairline bg-white">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              @foreach (head in table.headers)
                <th class="border-b border-hairline px-3 py-2.5 text-left align-top font-semibold text-heading">{{ $head.label }}</th>
              @endforeach
            </tr>
          </thead>
          <tbody>
            @forelse (row in table.rows)
              <tr>
                @foreach (cell in row.cells)
                  <td class="border-b border-hairline px-3 py-2.5 text-left align-top">{{ $cell.text }}</td>
                @endforeach
              </tr>
            @empty
              <tr><td class="px-3 py-2.5 text-[#5b6070]">No records yet.</td></tr>
            @endforelse
          </tbody>
        </table>
      </div>
    </section>
  @endforeach
@endsection
