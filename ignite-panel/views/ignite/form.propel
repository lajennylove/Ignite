  @include('ignite::partials.flash')
@endsection

@section('title')
  {{ $heading }}
@endsection

@section('content')
  <h1 class="mb-6">{{ $heading }}</h1>

  <form class="ig-card grid max-w-2xl gap-5" method="post" action="{{ $action }}">
    <input type="hidden" name="_token" value="{{ $csrf_token }}">

    @foreach (field in fields)
      <div>
        @if (field.is_checkbox)
          <label class="flex items-center gap-2 text-sm font-semibold text-heading">
            <input type="checkbox" class="h-4 w-4 rounded border-bordergray text-primary focus:ring-primary" name="{{ $field.name }}" value="on" @if (field.checked)checked@endif>
            {{ $field.label }}
          </label>
        @else
          <label class="ig-label" for="{{ $field.name }}">{{ $field.label }}@if (field.required) *@endif</label>
          @if (field.is_textarea)
            <textarea class="ig-input min-h-32" id="{{ $field.name }}" name="{{ $field.name }}">{{ $field.value }}</textarea>
          @elseif (field.is_select)
            <select class="ig-input" id="{{ $field.name }}" name="{{ $field.name }}">
              @foreach (option in field.options)
                <option value="{{ $option.value }}" @if (option.selected)selected@endif>{{ $option.label }}</option>
              @endforeach
            </select>
          @else
            <input class="ig-input" id="{{ $field.name }}" name="{{ $field.name }}" type="{{ $field.input_type }}" @if (field.has_step)step="{{ $field.step }}" @endif value="{{ $field.value }}">
          @endif
        @endif
        @if (field.has_error)
          <p class="mt-1.5 mb-0 text-sm text-error-emphasis">{{ $field.error }}</p>
        @endif
      </div>
    @endforeach

    <div class="flex flex-wrap items-center gap-3">
      <button type="submit" class="ig-btn ig-btn-primary">{{ $submit_label }}</button>
      <a class="ig-btn ig-btn-outline" href="{{ $back_url }}">Cancel</a>
    </div>
  </form>
@endsection
