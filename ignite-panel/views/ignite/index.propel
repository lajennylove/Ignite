@section('title')
  {{ $title }}
@endsection

@section('content')
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="mb-0">{{ $title }}</h1>
    @if (can_create)
      <a class="ig-btn ig-btn-primary" href="{{ $new_url }}">New {{ $singular }}</a>
    @endif
  </div>

  <section class="ig-card p-0">
    <form class="flex flex-wrap items-center gap-3 border-b border-border p-5" method="get" action="{{ $index_url }}">
      <input class="ig-input max-w-sm flex-[1_1_14rem]" type="search" name="q" value="{{ $search }}" placeholder="Search">
      <button type="submit" class="ig-btn ig-btn-outline">Search</button>
    </form>

    <div class="overflow-x-auto">
      <table class="ig-table">
        <thead>
          <tr>
            @foreach (column in columns)
              <th>
                @if (column.sortable)
                  <a class="whitespace-nowrap text-heading no-underline hover:underline" href="{{ $column.sort_url }}">{{ $column.label }} {{ $column.indicator }}</a>
                @else
                  {{ $column.label }}
                @endif
              </th>
            @endforeach
            <th></th>
          </tr>
        </thead>
        <tbody>
          @forelse (row in rows)
            <tr>
              @foreach (cell in row.cells)
                <td>{{ $cell.text }}</td>
              @endforeach
              <td class="whitespace-nowrap text-right">
                @if (can_update)
                  <a class="ig-btn ig-btn-ghost px-3 py-1" href="{{ $row.edit_url }}">Edit</a>
                @endif
                @if (can_delete)
                  <form class="inline" method="post" action="{{ $row.delete_url }}" data-confirm="Delete this record? This cannot be undone.">
                    <input type="hidden" name="_token" value="{{ $csrf_token }}">
                    <button type="submit" class="ig-btn ig-btn-danger px-3 py-1">Delete</button>
                  </form>
                @endif
              </td>
            </tr>
          @empty
            <tr>
              <td colspan="{{ $colspan }}" class="text-center text-text">No records found.</td>
            </tr>
          @endforelse
        </tbody>
      </table>
    </div>
  </section>

  <div class="mt-5 flex flex-wrap items-center gap-4 text-text">
    @if (has_prev)
      <a class="ig-btn ig-btn-outline px-3 py-1.5" href="{{ $prev_url }}">Previous</a>
    @endif
    <span>Page {{ $page }} of {{ $last_page }} · {{ $total }} in total</span>
    @if (has_next)
      <a class="ig-btn ig-btn-outline px-3 py-1.5" href="{{ $next_url }}">Next</a>
    @endif
  </div>
@endsection
