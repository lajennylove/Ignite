  </nav>
  <style>[data-ig-nav-item] > div > a { flex: 1 1 0%; min-width: 0; } [data-ig-nav-item-toggle][aria-expanded="false"] i { transform: rotate(-90deg); }</style>
  <script>
  // A navigation entry's group, as a WordPress menu with its submenu: the toggle beside the
  // entry shows or hides its create link and its child entries. The group of the current page
  // starts open; without JavaScript it is the only one that shows its links.
  document.querySelectorAll('[data-ig-nav-item-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      document.getElementById(button.getAttribute('aria-controls')).hidden = !open;
    });
  });
  </script>
@if (nav_collapsible)  <script>
  // Collapsible navigation groups, as Filament's: the heading collapses or expands the group,
  // and the browser remembers the collapsed groups by label (localStorage, as Filament's
  // `filament:sidebar:collapsed_groups`). A group starts collapsed when the panel says so and
  // nothing is saved yet. The group of the current page shows expanded. Without JavaScript
  // every group shows its entries.
  (() => {
    const key = 'ignite:sidebar:collapsed_groups';
    let saved = null;
    try {
      saved = JSON.parse(window.localStorage.getItem(key));
    } catch (error) {}
    const groups = Array.from(document.querySelectorAll('[data-ig-nav-group]'));
    let collapsed = Array.isArray(saved)
      ? saved
      : groups.filter((group) => group.hasAttribute('data-ig-nav-collapsed')).map((group) => group.dataset.igNavGroup);
    const save = () => {
      try {
        window.localStorage.setItem(key, JSON.stringify(collapsed));
      } catch (error) {}
    };
    if (!Array.isArray(saved)) {
      save();
    }
    const show = (group, expanded) => {
      const button = group.querySelector('[data-ig-nav-toggle]');
      button.setAttribute('aria-expanded', String(expanded));
      document.getElementById(button.getAttribute('aria-controls')).hidden = !expanded;
      button.querySelector('i').style.transform = expanded ? '' : 'rotate(-90deg)';
    };
    groups.forEach((group) => {
      const label = group.dataset.igNavGroup;
      show(group, group.hasAttribute('data-ig-nav-active') || !collapsed.includes(label));
      group.querySelector('[data-ig-nav-toggle]').addEventListener('click', (event) => {
        const expanded = event.currentTarget.getAttribute('aria-expanded') !== 'true';
        collapsed = collapsed.filter((other) => other !== label);
        if (!expanded) {
          collapsed.push(label);
        }
        save();
        show(group, expanded);
      });
    });
  })();
  </script>
@endif</aside>
@endif
