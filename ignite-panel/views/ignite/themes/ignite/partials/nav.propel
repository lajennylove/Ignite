  <nav class="flex flex-col gap-1 px-4 pb-6" aria-label="Main">
    <p class="ig-caption mt-2">Menu</p>
    @foreach (section in nav_sections)@if (section.has_heading)@if (section.collapsible)<div class="flex flex-col gap-1" data-ig-nav-group="{{ $section.heading }}"@if (section.collapsed) data-ig-nav-collapsed@endif@if (section.active) data-ig-nav-active@endif>
    <button type="button" class="ig-caption mt-5 flex w-full items-center justify-between" aria-expanded="true" aria-controls="{{ $section.items_id }}" data-ig-nav-toggle>{{ $section.heading }}<i class="ti ti-chevron-down text-lg transition-transform" aria-hidden="true"></i></button>
    <div id="{{ $section.items_id }}" class="flex flex-col gap-1">
    @else<p class="ig-caption mt-5">{{ $section.heading }}</p>
    @endif@endif@foreach (group in section.items)
      @if (group.has_sub_items)<div class="flex flex-col gap-1" data-ig-nav-item@if (group.open) data-ig-nav-open@endif>
      <div class="flex items-center gap-1">
      @endif@if (group.active)
        <a class="ig-nav-link ig-nav-link-active" href="{{ $group.url }}" aria-current="page"><i class="{{ $group.icon }} text-lg"></i>{{ $group.title }}</a>
      @else
        <a class="ig-nav-link" href="{{ $group.url }}"><i class="{{ $group.icon }} text-lg"></i>{{ $group.title }}</a>
      @endif@if (group.has_sub_items)
        <button type="button" class="ig-nav-link shrink-0" aria-expanded="{{ $group.aria_expanded }}" aria-controls="{{ $group.sub_items_id }}" aria-label="{{ $group.title }} menu" data-ig-nav-item-toggle><i class="ti ti-chevron-down text-lg transition-transform" aria-hidden="true"></i></button>
      </div>
      <div id="{{ $group.sub_items_id }}" class="flex flex-col gap-1"@if (group.closed) hidden@endif>
