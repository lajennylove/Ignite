@if (signed_in)
  <a class="font-semibold text-heading no-underline" href="{{ $profile_url }}">{{ $user_name }}</a>
  <form method="post" action="{{ $logout_everywhere_url }}">
    <input type="hidden" name="_token" value="{{ $csrf_token }}">
    <button type="submit" class="cursor-pointer rounded-md border border-accent bg-white px-3 py-1.5 font-[inherit] text-accent hover:bg-header">Sign out</button>
  </form>
@endif
