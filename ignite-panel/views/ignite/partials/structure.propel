{{-- A repeater or group on a resource form, as Filament's Repeater and Fieldset: its parts in order (see StructureContext in src/views.rs), so any nesting renders without recursion. Each sub-field input is named after its place, such as members[0][name], and the panel builds the field's JSON value from them. The buttons send the form to the form's live URL (formaction), which shows it again with the row added, deleted or moved and saves nothing; the form script does it without leaving the page. --}}
@foreach (part in field.parts)
@if (part.is_open)
<div class="ig-structure grid gap-3" data-ignite-field="{{ $part.name }}" data-ignite-structure="{{ $part.kind }}">
  <span class="ig-label">{{ $part.label }}@if (part.required) *@endif</span>
  @if (part.is_list)<input type="hidden" name="{{ $part.name }}" value="">@else<input type="hidden" name="{{ $part.marker }}" value="1">@endif
  <div class="@if (part.is_list)grid gap-3@else{{-- a group: one bordered block --}}ig-structure-row grid gap-4 rounded-md border border-border@endif">
@endif
@if (part.is_row)
  <div class="ig-structure-row grid gap-4 rounded-md border border-border" data-ignite-row="{{ $part.name }}">
    <input type="hidden" name="{{ $part.marker }}" value="1">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-semibold text-heading text-sm">{{ $part.label }}</span>
      <span class="ml-auto flex flex-wrap gap-2">
        @if (part.can_up)<button type="submit" class="ig-btn ig-btn-ghost px-3 py-1" formaction="{{ $part.ops_url }}" formnovalidate name="_ignite_op" value="{{ $part.up_op }}" data-ignite-op>Move up</button>@endif
        @if (part.can_down)<button type="submit" class="ig-btn ig-btn-ghost px-3 py-1" formaction="{{ $part.ops_url }}" formnovalidate name="_ignite_op" value="{{ $part.down_op }}" data-ignite-op>Move down</button>@endif
        @if (part.can_delete)<button type="submit" class="ig-btn ig-btn-danger px-3 py-1" formaction="{{ $part.ops_url }}" formnovalidate name="_ignite_op" value="{{ $part.delete_op }}" data-ignite-op>Delete</button>@endif
      </span>
    </div>
@endif
@foreach (field in part.fields)
    @include('ignite::partials.field')
@endforeach
@if (part.is_row_end)
  </div>
@endif
@if (part.is_close)
  </div>
  @if (part.can_add)<div><button type="submit" class="ig-btn ig-btn-outline" formaction="{{ $part.ops_url }}" formnovalidate name="_ignite_op" value="{{ $part.add_op }}" data-ignite-op>{{ $part.add_label }}</button></div>@endif
  @if (part.has_error)
  <p class="mt-1.5 mb-0 text-sm text-error-emphasis">{{ $part.error }}</p>
  @endif
</div>
@endif
@endforeach
