{{-- One form field: its label, its input and its error. The form and the profile page include it inside `@foreach (field in ...)`. The kinds added for custom fields render through partials/fields. A live field is marked `data-ignite-live`: the panel's script shows the form again when it changes. --}}
<div data-ignite-field="{{ $field.name }}"@if (field.live) data-ignite-live@endif>
  @if (field.is_checkbox)
    <label class="flex items-center gap-2 text-sm font-semibold text-heading">
      <input type="checkbox" class="h-4 w-4 rounded border-bordergray text-primary focus:ring-primary" name="{{ $field.name }}" value="on" @if (field.checked)checked@endif>
      {{ $field.label }}
    </label>
  @else
    <label class="ig-label" for="{{ $field.name }}">{{ $field.label }}@if (field.required) *@endif</label>
    @if (field.is_textarea)
      <textarea class="ig-input min-h-32" id="{{ $field.name }}" name="{{ $field.name }}">{{ $field.value }}</textarea>
    @elseif (field.is_select)
      <select class="ig-input" id="{{ $field.name }}" name="{{ $field.name }}">
        @foreach (option in field.options)
          <option value="{{ $option.value }}" @if (option.selected)selected@endif>{{ $option.label }}</option>
        @endforeach
      </select>
    @elseif (field.is.email)
      @include('ignite::partials.fields.email')
    @elseif (field.is.url)
      @include('ignite::partials.fields.url')
    @elseif (field.is.radio)
      @include('ignite::partials.fields.radio')
    @elseif (field.is.color)
      @include('ignite::partials.fields.color')
    @elseif (field.is.image)
      @include('ignite::partials.fields.image')
    @elseif (field.is.file)
      @include('ignite::partials.fields.file')
    @elseif (field.is.link)
      @include('ignite::partials.fields.link')
    @elseif (field.is.wysiwyg)
      @include('ignite::partials.fields.wysiwyg')
    @elseif (field.is.post_object)
      @include('ignite::partials.fields.post_object')
    @elseif (field.is.relationship)
      @include('ignite::partials.fields.relationship')
    @elseif (field.is.taxonomy)
      @include('ignite::partials.fields.taxonomy')
    @elseif (field.is.user)
      @include('ignite::partials.fields.user')
    @elseif (field.is.repeater)
      @include('ignite::partials.fields.repeater')
    @elseif (field.is.group)
      @include('ignite::partials.fields.group')
    @elseif (field.is.flexible_content)
      @include('ignite::partials.fields.flexible_content')
    @elseif (field.is.gallery)
      @include('ignite::partials.fields.gallery')
    @elseif (field.is.clone)
      @include('ignite::partials.fields.clone')
    @else
      <input class="ig-input" id="{{ $field.name }}" name="{{ $field.name }}" type="{{ $field.input_type }}" @if (field.has_step)step="{{ $field.step }}" @endif value="{{ $field.value }}">
    @endif
  @endif
  @if (field.has_error)
    <p class="mt-1.5 mb-0 text-sm text-error-emphasis">{{ $field.error }}</p>
  @endif
</div>
