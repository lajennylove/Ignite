{{-- One choice as radio buttons (FieldKind::Radio), as Filament's Radio. The hidden input sends the field blank when no button is chosen; a chosen button comes later in the form, so its value wins. --}}
<input type="hidden" name="{{ $field.name }}" value="">
<div class="grid gap-2" id="{{ $field.name }}" role="radiogroup">
  @foreach (option in field.options)
    <label class="flex items-center gap-2 text-sm">
      <input type="radio" class="h-4 w-4 border-bordergray text-primary focus:ring-primary" name="{{ $field.name }}" value="{{ $option.value }}" @if (option.selected)checked@endif>
      {{ $option.label }}
    </label>
  @endforeach
</div>
